{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "tsc --noEmit && vp build",
    "check": "vp check",
    "typecheck": "tsc --noEmit --pretty",
    "lint": "vp lint .",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "preview": "vp preview",
    "test": "vp test --maxWorkers=100%",
    "test:run": "vp test run --maxWorkers=100%",
    "test:related": "vp test related --run --maxWorkers=100%"
  },
  "dependencies": {
    "axios": "1.20.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
